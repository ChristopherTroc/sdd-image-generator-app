# Public variables (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Private variables (server-only)
# Get your free Hugging Face API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Custom endpoint for Hugging Face Inference API (optional)
# Useful for connecting to a dedicated inference endpoint or proxy
# Defaults to https://api-inference.huggingface.co if not set
# HF_INFERENCE_ENDPOINT=https://custom-hf-proxy.example.com
