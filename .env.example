# Public variables (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Private variables (server-only)
# Get your free Hugging Face API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Custom endpoints for Hugging Face private inference instances (optional)
# Each model has its own dedicated inference endpoint
# If not set, falls back to https://api-inference.huggingface.co/models/{model}
# HF_FLUX_ENDPOINT=https://flux-schnell-private-endpoint.hf.space
# HF_STABLE_DIFFUSION_ENDPOINT=https://sd-xl-base-private-endpoint.hf.space
